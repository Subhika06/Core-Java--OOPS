
import java.util.Scanner;

class Delivery {
    double orderAmount;

    Delivery(double orderAmount) {
        this.orderAmount = orderAmount;
    }

    double calculateDeliveryCharge() {
        return orderAmount;
    }
}

class RegularDelivery extends Delivery {
    RegularDelivery(double orderAmount) {
        super(orderAmount);
    }

    @Override
    double calculateDeliveryCharge() {
        return orderAmount + 40;
    }
}

class ExpressDelivery extends Delivery {
    ExpressDelivery(double orderAmount) {
        super(orderAmount);
    }

    @Override
    double calculateDeliveryCharge() {
        return orderAmount + 80 + (orderAmount * 0.05);
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int deliveryType = sc.nextInt();
        double amount = sc.nextDouble();

        Delivery delivery;

        if (deliveryType == 1) {
            delivery = new RegularDelivery(amount);
        } else {
            delivery = new ExpressDelivery(amount);
        }

        System.out.printf("Final Delivery Charge: %.2f%n",
                delivery.calculateDeliveryCharge());

        sc.close();
    }
}
